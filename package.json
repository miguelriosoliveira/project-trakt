{
	"name": "project-trakt",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=26.13.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check --write && tailwint --fix",
		"lint:check": "biome check && tailwint",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"test:mutation": "stryker run",
		"prepare": "husky"
	},
	"dependencies": {
		"@sentry/nextjs": "^11.11.0",
		"next": "16.4.5",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-icons": "^5.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@miguelriosoliveira/shared-configs": "github:miguelriosoliveira/shared-configs",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.5",
		"tailwint": "^1.1.16",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
